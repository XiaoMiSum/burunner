# burunner 环境变量示例
# 复制为 .env 后按需填写。CLI 参数 (--llm/--model/--api-key 等) 优先级高于此文件。

# ===== 统一 LLM 配置 =====
# Provider: openai, azure_openai, anthropic, google, deepseek, ollama, grok, mistral, alibaba, modelscope, moonshot, siliconflow, ibm, unbound
BURUNNER_LLM_PROVIDER=openai
BURUNNER_LLM_MODEL=gpt-4o
BURUNNER_LLM_TEMPERATURE=0.0
BURUNNER_LLM_BASE_URL=
BURUNNER_LLM_API_KEY=

# ===== 其他配置 =====
BURUNNER_HEADLESS=true
# 浏览器类型: chromium(默认) / chrome / chrome-beta / chrome-dev / chrome-canary / msedge / msedge-beta / msedge-dev / msedge-canary
BURUNNER_BROWSER_CHANNEL=
BURUNNER_PARALLEL=1
BURUNNER_MAX_STEPS=30
BURUNNER_CASE_TIMEOUT=0
BURUNNER_RETRY_COUNT=0
BURUNNER_RETRY_DELAY=2.0
BURUNNER_ENV=

# ===== 通知配置 =====
# 通知渠道（一次只激活一个）: wecom / feishu / dingtalk
BURUNNER_NOTIFY_CHANNEL=
# 对应平台的 Webhook URL
BURUNNER_NOTIFY_WEBHOOK=

# ===== Provider 专用配置 =====
# Azure OpenAI 专用
BURUNNER_AZURE_API_VERSION=2025-01-01-preview

# IBM watsonx 专用
BURUNNER_IBM_PROJECT_ID=
